# wb_fulltext_csv.py の設定ファイルの見本。
# このファイルを .env という名前でコピーし、値を書き換えて使う（.env は Git に登録しない）。
# 書き方: 1 行に 1 項目、KEY=VALUE。# で始まる行はコメント。値は "…" か '…' で囲んでもよい。
# 優先順: コマンドライン > 環境変数 > .env > 既定値。--limit と --refresh は指定できない。
# 文字コード: UTF-8（BOM 付きでもよい）。

# 対象リポジトリのホスト（--host。必須）
WB_HOST=jircas.repo.nii.ac.jp

# User-Agent に付ける連絡先（任意）
#WB_CONTACT=your-address@example.org

# IRDB OpenSearch の q（--query。既定: WB_HOST と同じ）
#WB_QUERY=

# 出力する CSV（--out。既定: wayback_fulltext.csv）
#WB_OUT=result.csv

# キャッシュの保存先（--cache-dir。既定: .wb_cache）
#WB_CACHE_DIR=.wb_cache

# リクエスト間隔の秒数（--interval。既定: 1.0）
#WB_INTERVAL=1.0

# 一括取得（--bulk / --no-bulk。true か false。既定: true）
#WB_BULK=true

# 一括取得の 1 回あたりの行数（--bulk-page-size。既定: 5000）
#WB_BULK_PAGE_SIZE=5000

# ライセンス情報の取得（--license / --no-license。true か false。既定: true）
#WB_LICENSE=true
